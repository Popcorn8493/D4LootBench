<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Dark counterparts of Light.xaml's semantic chrome brushes. -->
    <SolidColorBrush x:Key="App.BorderBrush"    Color="#3F3F46" />
    <SolidColorBrush x:Key="App.DividerBrush"   Color="#4A4A50" />
    <SolidColorBrush x:Key="App.SplitterBrush"  Color="#333338" />
    <SolidColorBrush x:Key="App.PanelBrush"     Color="#2A2A2E" />
    <SolidColorBrush x:Key="App.TextBrush"      Color="#C8C8C8" />
    <SolidColorBrush x:Key="App.TextMutedBrush" Color="#B4B4B4" />
    <SolidColorBrush x:Key="App.TextFaintBrush" Color="#9A9A9A" />
    <SolidColorBrush x:Key="App.ErrorBrush"     Color="#FF8577" />
    <SolidColorBrush x:Key="App.HoverBrush"     Color="#3A3630" />
    <SolidColorBrush x:Key="App.SelectionBrush" Color="#5C4A28" />

</ResourceDictionary>
