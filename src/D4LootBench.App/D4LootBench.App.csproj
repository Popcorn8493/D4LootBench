<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\D4LootBench.Core\D4LootBench.Core.csproj" />
    <ProjectReference Include="..\D4LootBench.Ai\D4LootBench.Ai.csproj" />
    <ProjectReference Include="..\D4LootBench.Paragon\D4LootBench.Paragon.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AvalonEdit" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Web.WebView2" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Versioned Windows TFM: exposes the WinRT projections Windows.Media.Ocr needs. -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <!-- WPF0001: Application.ThemeMode (Fluent light/dark) is marked experimental. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
    <RootNamespace>D4LootBench.App</RootNamespace>
    <AssemblyName>D4LootBench</AssemblyName>
    <ApplicationIcon>Assets\d4lootbench.ico</ApplicationIcon>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\d4lootbench.ico" />
  </ItemGroup>

</Project>
