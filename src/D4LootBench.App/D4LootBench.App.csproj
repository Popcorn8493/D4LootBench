<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\D4LootBench.Core\D4LootBench.Core.csproj" />
    <ProjectReference Include="..\D4LootBench.Ai\D4LootBench.Ai.csproj" />
    <ProjectReference Include="..\D4LootBench.Paragon\D4LootBench.Paragon.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AvalonEdit" Version="6.3.1.120" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Versioned Windows TFM: exposes the WinRT projections Windows.Media.Ocr needs. -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>D4LootBench.App</RootNamespace>
    <AssemblyName>D4LootBench</AssemblyName>
    <ApplicationIcon>Assets\d4lootbench.ico</ApplicationIcon>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\d4lootbench.ico" />
  </ItemGroup>

</Project>
