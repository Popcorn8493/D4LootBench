<Window
    x:Class="D4LootBench.App.Views.ParagonPlannerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:D4LootBench.App.ViewModels"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance Type=vm:ParagonPlannerViewModel, IsDesignTimeCreatable=False}"
    Title="{Binding WindowTitle}"
    Height="780" Width="1160"
    MinHeight="500" MinWidth="900"
    WindowStartupLocation="CenterScreen"
    UseLayoutRounding="True"
    PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <SolidColorBrush x:Key="NormalNodeBrush"   Color="#8A8A8A" />
        <SolidColorBrush x:Key="MagicNodeBrush"    Color="#5B7FD4" />
        <SolidColorBrush x:Key="RareNodeBrush"     Color="#D4B45E" />
        <SolidColorBrush x:Key="LegendaryNodeBrush" Color="#D0603A" />
        <SolidColorBrush x:Key="SocketNodeBrush"   Color="#5BB8A8" />
        <SolidColorBrush x:Key="GateNodeBrush"     Color="#C9A45C" />
        <SolidColorBrush x:Key="StartNodeBrush"    Color="#F0EAD8" />
        <SolidColorBrush x:Key="BoardBackground"   Color="#1E1A17" />

        <Style x:Key="SummaryLine" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#555" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,0,0" />
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Long diagnostic lines stay one line high (hover for the full text) so the pinned
             summary can't grow until it squeezes the tabs below it out of view. -->
        <Style x:Key="CompactSummaryLine" TargetType="TextBlock" BasedOn="{StaticResource SummaryLine}">
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="ToolbarDivider" TargetType="Border">
            <Setter Property="Width" Value="1" />
            <Setter Property="Height" Value="20" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="#D4D4D4" />
            <Setter Property="Margin" Value="10,3" />
        </Style>

        <!-- The one primary action per screen — green to match the purchased-path color -->
        <Style x:Key="AccentButton" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#4E8340" />
            <Setter Property="BorderBrush" Value="#3E6833" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#5C9A4C" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#3E6833" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Background" Value="#AFC0A9" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#A0B29A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- ── Controls ─────────────────────────────────────────────── -->
        <Border DockPanel.Dock="Top" Padding="10,8" BorderThickness="0,0,0,1" BorderBrush="#DDD">
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsBusy}" Value="True">
                            <Setter Property="IsEnabled" Value="False" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel>
                <!-- Everything lives in the menus; the toolbar keeps only the per-minute actions. -->
                <Menu Background="Transparent" Margin="-4,0,0,4">
                    <MenuItem Header="_File">
                        <MenuItem Header="_Open Project…" InputGestureText="Ctrl+O" Command="{Binding OpenProjectCommand}" />
                        <MenuItem Header="Open _Recent" ItemsSource="{Binding RecentProjects}">
                            <MenuItem.Style>
                                <Style TargetType="MenuItem">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding RecentProjects.Count}" Value="0">
                                            <Setter Property="IsEnabled" Value="False" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </MenuItem.Style>
                            <MenuItem.ItemContainerStyle>
                                <Style TargetType="MenuItem">
                                    <Setter Property="Header" Value="{Binding}" />
                                    <!-- HeaderTemplate keeps underscores in file names from becoming mnemonics -->
                                    <Setter Property="HeaderTemplate">
                                        <Setter.Value>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding FileName}" />
                                            </DataTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Setter Property="ToolTip" Value="{Binding FullPath}" />
                                    <Setter Property="Command"
                                            Value="{Binding DataContext.OpenRecentProjectCommand, RelativeSource={RelativeSource AncestorType=Menu}}" />
                                    <Setter Property="CommandParameter" Value="{Binding}" />
                                </Style>
                            </MenuItem.ItemContainerStyle>
                        </MenuItem>
                        <Separator />
                        <MenuItem Header="_Save Project" InputGestureText="Ctrl+S" Command="{Binding SaveProjectCommand}"
                                  ToolTip="Saves straight to the current file (shown in the window title); asks where the first time" />
                        <MenuItem Header="Save Project _As…" InputGestureText="Ctrl+Shift+S" Command="{Binding SaveProjectAsCommand}"
                                  ToolTip="Save to a new file, which then becomes the Ctrl+S target" />
                        <Separator />
                        <MenuItem Header="_Export Maxroll Code" Command="{Binding ExportMaxrollCodeCommand}"
                                  ToolTip="Copy the current allocation to the clipboard as a Maxroll planner variant code" />
                    </MenuItem>
                    <MenuItem Header="_Edit">
                        <MenuItem Header="_Undo" InputGestureText="Ctrl+Z" Command="{Binding UndoCommand}"
                                  ToolTip="Undoes targets, boards, solves, spends, imports, and applied suggestions. Glyph picks, rules, and checkboxes aren't tracked — flip those back by hand." />
                        <MenuItem Header="_Redo" InputGestureText="Ctrl+Y" Command="{Binding RedoCommand}" />
                        <Separator />
                        <MenuItem Header="_Clear Targets" Command="{Binding ClearTargetsCommand}" />
                    </MenuItem>
                    <MenuItem Header="_Build">
                        <MenuItem Header="_Solve Path" InputGestureText="F5" Command="{Binding SolveCommand}"
                                  ToolTip="Find the cheapest connected path through every target" />
                        <MenuItem Header="Re-_analyze (solve + full spend)" InputGestureText="F6" Command="{Binding ReanalyzeCommand}"
                                  ToolTip="Solve the path fresh, then spend ALL remaining points of the pool with the Optimize-tab settings" />
                        <MenuItem Header="Spend Remaining _Points" Command="{Binding MaximizePointsCommand}"
                                  ToolTip="Grow the current path with the leftover points (settings on the Optimize tab)" />
                        <Separator />
                        <MenuItem Header="_Import Build from Clipboard" InputGestureText="Ctrl+I" Command="{Binding ImportBuildCommand}"
                                  ToolTip="A Maxroll variant code, a maxroll.gg planner or build-guide URL, a mobalytics.gg build URL, or the page's HTML if fetching is blocked" />
                        <MenuItem Header="_Compare with Clipboard Build" Command="{Binding CompareImportCommand}"
                                  ToolTip="Points, stats, glyphs, and which is best — the current build vs the one on the clipboard" />
                        <MenuItem Header="Com_bine with Clipboard Build" Command="{Binding CombineImportCommand}"
                                  ToolTip="Merge the clipboard build into the current one, then re-solve the cheapest path covering both builds' rare and legendary nodes" />
                        <Separator />
                        <MenuItem Header="Plan _Layout from Goals…" Command="{Binding PlanLayoutCommand}"
                                  ToolTip="Pick the boards you want (or a pool to choose from) and the glyphs to socket — the optimizer finds positions, rotations, and glyph placement, then solves the path" />
                        <MenuItem Header="Analy_ze Placement" Command="{Binding AnalyzePlacementCommand}"
                                  ToolTip="Suggests better rotations, board swaps, and glyph sockets — results appear on the Optimize tab" />
                    </MenuItem>
                </Menu>

                <WrapPanel Margin="0,0,0,6">
                    <TextBlock Text="Class:" VerticalAlignment="Center" Margin="0,0,5,0" />
                    <ComboBox ItemsSource="{Binding Classes}" SelectedItem="{Binding SelectedClass}"
                              Width="110" />

                    <Border Style="{StaticResource ToolbarDivider}" />
                    <Button Command="{Binding SolveCommand}" Padding="10,3" Margin="0,0,6,0"
                            Style="{StaticResource AccentButton}"
                            ToolTip="Find the cheapest connected path through every target (F5)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE9D2;" FontFamily="Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center" Margin="0,0,5,0" />
                            <TextBlock Text="Solve Path" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding ReanalyzeCommand}" Padding="10,3" Margin="0,0,6,0"
                            ToolTip="Re-run everything after a change: solve the path fresh, then spend ALL remaining points of the pool with the Optimize-tab settings (focused stats, rare/threshold preferences) (F6)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center" Margin="0,0,5,0" />
                            <TextBlock Text="Re-analyze" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Border Style="{StaticResource ToolbarDivider}" />
                    <Button Command="{Binding UndoCommand}" Padding="8,3" Margin="0,0,4,0"
                            AutomationProperties.Name="Undo"
                            ToolTip="Undo the last change — targets, boards, solves, spends, imports, applied suggestions (Ctrl+Z). Glyph picks, rules, and checkboxes aren't tracked; flip those back by hand.">
                        <TextBlock Text="&#xE7A7;" FontFamily="Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center" />
                    </Button>
                    <Button Command="{Binding RedoCommand}" Padding="8,3"
                            AutomationProperties.Name="Redo"
                            ToolTip="Redo the change you just undid (Ctrl+Y)">
                        <TextBlock Text="&#xE7A6;" FontFamily="Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center" />
                    </Button>

                    <Border Style="{StaticResource ToolbarDivider}" />
                    <Button Command="{Binding ImportBuildCommand}" Padding="10,3" Margin="0,0,6,0"
                            ToolTip="Import a paragon build from the clipboard: a Maxroll variant code, a maxroll.gg planner or build-guide URL, a mobalytics.gg build URL, or the page's HTML if fetching is blocked (Ctrl+I)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center" Margin="0,0,5,0" />
                            <TextBlock Text="Import Build" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding SaveProjectCommand}" Padding="10,3"
                            ToolTip="Save the planner session straight to the current file — no dialog after the first save (Ctrl+S). The window title shows which file. Use File > Save As for a new file.">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center" Margin="0,0,5,0" />
                            <TextBlock Text="Save" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </WrapPanel>

                <WrapPanel>
                    <TextBlock Text="Attach:" VerticalAlignment="Center" Margin="0,0,5,0" />
                    <ComboBox ItemsSource="{Binding AttachableBoards}" SelectedItem="{Binding SelectedAttachBoard}"
                              DisplayMemberPath="Name" Width="170" Margin="0,0,8,0" />
                    <TextBlock Text="to slot" VerticalAlignment="Center" Margin="0,0,5,0" />
                    <ComboBox ItemsSource="{Binding ParentSlots}" SelectedItem="{Binding SelectedParentSlot}"
                              Width="46" Margin="0,0,8,0" />
                    <TextBlock Text="edge" VerticalAlignment="Center" Margin="0,0,5,0" />
                    <ComboBox ItemsSource="{Binding Edges}" SelectedItem="{Binding SelectedEdge}"
                              Width="80" Margin="0,0,8,0" />
                    <TextBlock Text="rotation" VerticalAlignment="Center" Margin="0,0,5,0" />
                    <ComboBox ItemsSource="{Binding Rotations}" SelectedItem="{Binding SelectedRotation}"
                              Width="60" Margin="0,0,10,0" />
                    <Button Command="{Binding AddBoardCommand}" Content="Add Board" Padding="10,3" Margin="0,0,6,0" />
                    <Button Command="{Binding RemoveLastBoardCommand}" Content="Remove Last" Padding="10,3" Margin="0,0,16,0" />
                    <Button Command="{Binding PlanLayoutCommand}" Content="Plan Layout" Padding="10,3"
                            ToolTip="Start from the goal: pick the boards you want (or a pool to choose from) and the glyphs to socket — the optimizer finds positions, rotations, and glyph placement, then solves the path" />
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- ── Status ───────────────────────────────────────────────── -->
        <Border DockPanel.Dock="Bottom" Padding="10,6" BorderThickness="0,1,0,0" BorderBrush="#DDD">
            <StackPanel>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                               Foreground="#C0392B" VerticalAlignment="Top" Margin="0,2,6,0"
                               Visibility="{Binding StatusIsError, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                                        <Setter Property="Foreground" Value="#C0392B" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </DockPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="130"
                              PreviewMouseWheel="InnerScroll_PreviewMouseWheel">
                    <ScrollViewer.Style>
                        <Style TargetType="ScrollViewer">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SolveDetails}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ScrollViewer.Style>
                    <TextBlock Text="{Binding SolveDetails}" TextWrapping="Wrap" Foreground="#666" Margin="0,3,0,0" />
                </ScrollViewer>
            </StackPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="360" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="360" MinWidth="280" MaxWidth="560" />
            </Grid.ColumnDefinitions>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          Background="#EEE" ToolTip="Drag to resize the side panel" />

        <!-- ── Build summary, glyphs & node rules ───────────────────── -->
        <Border Grid.Column="2" BorderThickness="1,0,0,0" BorderBrush="#DDD">
            <DockPanel>
                <!-- Pinned build summary -->
                <Border DockPanel.Dock="Top" Padding="10,8" BorderThickness="0,0,0,1" BorderBrush="#DDD">
                    <StackPanel>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Build Summary" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="1" Text="{Binding PointsSummary}" FontSize="11" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding PointsSummary}" Margin="8,0,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#666" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding PointsOverBudget}" Value="True">
                                                <Setter Property="Foreground" Value="#C0392B" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                        <ProgressBar Height="6" Minimum="0" Maximum="1" Value="{Binding PointsFraction, Mode=OneWay}"
                                     Margin="0,0,0,4">
                            <ProgressBar.Style>
                                <Style TargetType="ProgressBar">
                                    <Setter Property="Foreground" Value="#7CCB5A" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding PointsOverBudget}" Value="True">
                                            <Setter Property="Foreground" Value="#C0392B" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ProgressBar.Style>
                        </ProgressBar>
                        <TextBlock Text="{Binding NodeMixSummary}" Style="{StaticResource SummaryLine}" />
                        <TextBlock Text="{Binding PerBoardSummary}" Style="{StaticResource CompactSummaryLine}">
                            <TextBlock.ToolTip>
                                <StackPanel MaxWidth="420">
                                    <TextBlock Text="{Binding PerBoardSummary}" TextWrapping="Wrap" />
                                    <TextBlock Text="Compare with the game's per-board point totals to find where a hand-copied build diverges."
                                               TextWrapping="Wrap" Foreground="#888" Margin="0,4,0,0" />
                                </StackPanel>
                            </TextBlock.ToolTip>
                        </TextBlock>
                        <TextBlock Text="{Binding AttachOrderSummary}" Style="{StaticResource CompactSummaryLine}">
                            <TextBlock.ToolTip>
                                <StackPanel MaxWidth="420">
                                    <TextBlock Text="{Binding AttachOrderSummary}" TextWrapping="Wrap" />
                                    <TextBlock Text="The game assigns threshold tiers by ATTACHMENT order, which follows your gate purchases along the path — attach boards in-game in this order."
                                               TextWrapping="Wrap" Foreground="#888" Margin="0,4,0,0" />
                                </StackPanel>
                            </TextBlock.ToolTip>
                        </TextBlock>
                        <Button Command="{Binding RenumberToPathOrderCommand}" Content="Renumber to path order"
                                Padding="8,2" Margin="0,4,0,0" HorizontalAlignment="Left" FontSize="11"
                                ToolTip="Rewrite slot numbers AND parent links to match how the path actually assembles the build — the current tree claims attachments whose crossings are never bought. Positions, path, targets, and glyphs are preserved.">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding AttachOrderSummary}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <TextBlock Text="{Binding GlyphSummary}" Style="{StaticResource SummaryLine}" />
                        <TextBlock Text="{Binding ThresholdSummary}" Style="{StaticResource SummaryLine}" />
                        <!-- Many unmet thresholds must not push the tabs off-screen — cap and scroll -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="96"
                                      PreviewMouseWheel="InnerScroll_PreviewMouseWheel">
                            <ItemsControl ItemsSource="{Binding ThresholdWarnings}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" FontSize="11" Foreground="#B8641B"
                                                   TextWrapping="Wrap" Margin="0,2,0,0" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>

                <TabControl BorderThickness="0" Background="Transparent" Padding="0" Margin="0,4,0,0">
                    <TabItem Header="Build">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10,8">
                        <TextBlock Text="Character Stats" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <StackPanel>
                                <TextBlock Text="Core stats from everything except paragon (level, gear, item bonuses). Rare-node threshold bonuses check the character TOTAL — these are added to the paragon-provided stat."
                                           FontSize="11" Foreground="#888" TextWrapping="Wrap" Margin="0,0,0,4" />
                                <UniformGrid Columns="2">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                        <TextBlock Text="Strength" Width="66" VerticalAlignment="Center" FontSize="11" />
                                        <TextBox Text="{Binding SheetStrength, UpdateSourceTrigger=PropertyChanged}" Width="44" FontSize="11" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="8,0,0,3">
                                        <TextBlock Text="Intelligence" Width="66" VerticalAlignment="Center" FontSize="11" />
                                        <TextBox Text="{Binding SheetIntelligence, UpdateSourceTrigger=PropertyChanged}" Width="44" FontSize="11" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                        <TextBlock Text="Willpower" Width="66" VerticalAlignment="Center" FontSize="11" />
                                        <TextBox Text="{Binding SheetWillpower, UpdateSourceTrigger=PropertyChanged}" Width="44" FontSize="11" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="8,0,0,3">
                                        <TextBlock Text="Dexterity" Width="66" VerticalAlignment="Center" FontSize="11" />
                                        <TextBox Text="{Binding SheetDexterity, UpdateSourceTrigger=PropertyChanged}" Width="44" FontSize="11" />
                                    </StackPanel>
                                </UniformGrid>
                                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                    <TextBlock Text="Point pool" Width="66" VerticalAlignment="Center" FontSize="11" />
                                    <TextBox Text="{Binding TotalPoints, UpdateSourceTrigger=PropertyChanged}" Width="44" FontSize="11"
                                             ToolTip="Your total paragon points (300 from levels + seasonal rank rewards)" />
                                </StackPanel>
                            </StackPanel>

                        <Separator Margin="0,10,0,8" />
                        <TextBlock Text="Stat Totals" FontWeight="SemiBold" />
                        <TextBlock Text="Click a row to highlight its nodes on the board; click again to clear. The gray number is the ceiling if every remaining node granting the stat were bought."
                                   FontSize="11" Foreground="#888" TextWrapping="Wrap" Margin="0,0,0,4" />
                            <StackPanel>
                                <TextBlock Text="Solve a path or import a build to see its effective stat totals."
                                           FontSize="11" Foreground="#888" TextWrapping="Wrap">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding StatTotals.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <Border BorderBrush="#E3E3E3" BorderThickness="1" CornerRadius="3">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding StatTotals.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                        <ItemsControl ItemsSource="{Binding StatTotals}" Margin="6,3">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:StatTotalLine}">
                                                    <Button Command="{Binding DataContext.ToggleStatHighlightCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}" Cursor="Hand"
                                                            ToolTip="{Binding Detail}" HorizontalContentAlignment="Stretch">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border x:Name="RowBackground" Background="Transparent" Padding="2,1" CornerRadius="2">
                                                                    <ContentPresenter />
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="RowBackground" Property="Background" Value="#F2ECE1" />
                                                                    </Trigger>
                                                                    <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                                                                        <Setter TargetName="RowBackground" Property="Background" Value="#FFE9C8" />
                                                                    </DataTrigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                        <Grid>
                                                            <Grid.Resources>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="FontSize" Value="12" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsCore}" Value="True">
                                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Grid.Resources>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Grid.Column="1" Text="{Binding Value}" Margin="8,0,0,0" />
                                                            <!-- ceiling if every remaining node granting the stat were bought -->
                                                            <TextBlock Grid.Column="2" Text="{Binding Possible}" Margin="4,0,0,0"
                                                                       FontSize="11" Foreground="#999" FontWeight="Normal" />
                                                        </Grid>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                </Border>
                            </StackPanel>
                    </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="Glyphs">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding GlyphSockets}" Margin="10,8">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:GlyphSocketViewModel}">
                                        <Border BorderBrush="#E3E3E3" BorderThickness="1" CornerRadius="3" Padding="6,4" Margin="0,0,0,6">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Header}" FontSize="11" Foreground="#666" Margin="0,0,0,3" />
                                                <ComboBox ItemsSource="{Binding Glyphs}" SelectedItem="{Binding SelectedGlyph}"
                                                          DisplayMemberPath="Name" Margin="0,0,0,4" MaxDropDownHeight="340"
                                                          ToolTip="Glyph socketed on this board — with the list open, type a name to jump to it" />
                                                <WrapPanel Margin="0,0,0,3">
                                                    <TextBlock Text="Level" VerticalAlignment="Center" FontSize="11" Margin="0,0,4,0" />
                                                    <TextBox Text="{Binding Level}" Width="36" FontSize="11"
                                                             ToolTip="Glyph level — sets the radius (3 / 4 at 25 / 5 at 50)" />
                                                    <TextBlock Text="{Binding Radius, StringFormat='  radius {0}   needs'}" VerticalAlignment="Center" FontSize="11" />
                                                    <TextBox Text="{Binding RequiredStat}" Width="36" FontSize="11" Margin="4,0"
                                                             ToolTip="Stat required in radius for the additional bonus (engine-side value — edit to match the in-game tooltip)" />
                                                    <TextBlock Text="{Binding StatName}" VerticalAlignment="Center" FontSize="11" />
                                                </WrapPanel>
                                                <CheckBox IsChecked="{Binding EnsureActive}" FontSize="11"
                                                          Content="Buy stat in radius to activate on Solve" />
                                                <CheckBox IsChecked="{Binding HighlightRadius}" FontSize="11" Margin="0,3,0,0"
                                                          Content="Highlight radius on the board"
                                                          ToolTip="Tint the cells this glyph's radius covers on the board canvas" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </TabItem>

                    <!-- The panel header sets the UIA name explicitly — a StackPanel header has none -->
                    <TabItem AutomationProperties.Name="Optimize">
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Optimize" />
                                <!-- Pending placement suggestions, so results don't hide behind the tab -->
                                <Border Background="#4A7A9E" CornerRadius="7" Padding="5,0,5,1" Margin="4,0,0,0"
                                        VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Suggestions.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding Suggestions.Count}" Foreground="White" FontSize="10" />
                                </Border>
                            </StackPanel>
                        </TabItem.Header>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="10,8">
                                <TextBlock Text="Build References" FontWeight="SemiBold" Margin="0,0,0,4" />
                                <TextBlock Text="Teach the optimizer what your build stacks. Import a build guide — its paragon boards AND its skill setup each vote — or add the loaded loot filter's gear priorities. Every reference votes on the focus stats below; several references become a consensus. References are saved with the project."
                                           FontSize="11" Foreground="#888" TextWrapping="Wrap" Margin="0,0,0,4" />
                                <WrapPanel Margin="0,0,0,4">
                                    <Button Command="{Binding AddBuildReferenceCommand}" Content="Add Build Guide" Padding="10,3" Margin="0,0,4,4"
                                            ToolTip="Copy a guide to the clipboard (Maxroll code or URL, Mobalytics URL, or the page's HTML), then click: the guide's paragon allocation votes on the focus stats, and a Mobalytics guide's SKILLS vote too (main skill's damage type, crit/vulnerable/overpower and other mechanics from the skill tree). Your boards and path stay untouched. If the guide has several build versions (e.g. a Selig setup and the standard setup) pick any number — each votes as its own reference, and re-importing a variant updates its old entry. Follow with Re-analyze." />
                                    <Button Command="{Binding AddGearReferenceCommand}" Content="Add Loaded Filter" Padding="10,3" Margin="0,0,4,4"
                                            ToolTip="Add the main window's loot filter as a reference: its per-slot affix priorities (top affix weighs most, Greater Affix wishes weigh extra, the same stat wanted on several slots stacks) are translated to paragon board stats and vote in the same consensus as imported guides. Gear stats the boards can't supply are reported, not force-fitted. Follow with Re-analyze." />
                                    <Button Command="{Binding ClearBuildReferencesCommand}" Content="Clear All" Padding="8,3" Margin="0,0,0,4"
                                            ToolTip="Forget every reference (focus stats keep their current selection)" />
                                </WrapPanel>
                                <Border BorderBrush="#E3E3E3" BorderThickness="1" CornerRadius="3" Margin="0,0,0,4">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ReferenceItems.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <ItemsControl ItemsSource="{Binding ReferenceItems}" Margin="6,3">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:ReferenceListItem}">
                                                <DockPanel Margin="0,1">
                                                    <Button DockPanel.Dock="Right" Content="&#x2715;" Padding="5,0" FontSize="10" Margin="6,0,0,0"
                                                            Command="{Binding DataContext.RemoveReferenceCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip="Remove this reference and re-derive the priorities from the rest" />
                                                    <TextBlock Text="{Binding Source}" FontSize="11" VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Detail}" />
                                                </DockPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>
                                <TextBlock Text="{Binding ReferenceSummary}" FontSize="11" Foreground="#4A7A9E"
                                           TextWrapping="Wrap" Margin="0,0,0,6">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ReferenceSummary}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <Separator Margin="0,10,0,8" />
                                <TextBlock Text="Spend Remaining Points" FontWeight="SemiBold" Margin="0,0,0,4" />
                                <TextBlock Text="After solving, spend the leftover of your point pool on focused stats and/or rare (yellow) nodes."
                                           FontSize="11" Foreground="#888" TextWrapping="Wrap" Margin="0,0,0,4" />
                                <Border BorderBrush="#E3E3E3" BorderThickness="1" CornerRadius="3" Margin="0,0,0,4">
                                        <ItemsControl ItemsSource="{Binding FocusStats}" Margin="4,2">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:FocusStatViewModel}">
                                                    <Grid Margin="0,1">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <CheckBox IsChecked="{Binding IsSelected}" FontSize="11" VerticalAlignment="Center"
                                                                  ToolTip="{Binding DisplayName}">
                                                            <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                                                        </CheckBox>
                                                        <ComboBox Grid.Column="1" ItemsSource="{x:Static vm:FocusStatViewModel.Priorities}"
                                                                  SelectedItem="{Binding Priority}" Width="66" FontSize="11"
                                                                  Visibility="{Binding IsSelected, Converter={StaticResource BoolToVis}}"
                                                                  ToolTip="How hard the maximizer chases this stat: High weighs 3×, Low 0.3× a Normal stat" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                </Border>
                                <CheckBox IsChecked="{Binding PreferRareNodes}" Content="Prefer rare (yellow) nodes first" FontSize="11" Margin="0,0,0,4"
                                          ToolTip="Buy reachable rare nodes before spending the rest on the focused stats. With focus stats selected, only rares DIRECTLY granting one of them are bought — off-build rares (e.g. max life on a damage build) are skipped entirely, even if their threshold bonus touches a focused stat. Click a skipped rare as a target if you want it anyway." />
                                <CheckBox IsChecked="{Binding RealisticRares}" Content="Rank rares by attainable thresholds" FontSize="11" Margin="18,0,0,4"
                                          IsEnabled="{Binding PreferRareNodes}"
                                          ToolTip="Buy 'good' rares first: threshold bonuses already met, then ones the boards can realistically still supply the stat for, then plain rares — rares whose bonus is out of reach come last. Requirements count your Character Stats (level/gear)." />
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="Survivability:" FontSize="11" VerticalAlignment="Center" Margin="0,0,5,0" />
                                    <ComboBox ItemsSource="{x:Static vm:ParagonPlannerViewModel.SurvivabilityLevels}"
                                              SelectedItem="{Binding SurvivabilityLevel}" Width="90" FontSize="11"
                                              ToolTip="Reserves a share of the leftover points for the best defensive value on the boards (life, armor, resists, dodge, healing…) BEFORE the focused-stat spend — Light 15%, Balanced 30%, Heavy 50%. Defensive rares also qualify for the rare phase, and reallocation won't trade the defense away. Hitting hard but dying? Raise this and Re-analyze." />
                                </StackPanel>
                                <CheckBox IsChecked="{Binding ActivateThresholds}" Content="Activate rare-node thresholds" FontSize="11" Margin="0,0,0,4"
                                          ToolTip="Buy whatever core stat unmet rare-node threshold bonuses are short of (smallest deficit first) before spending on focused stats. Requirements check the character TOTAL — enter your level/gear stats under Character Stats. Warns when the boards can't supply enough." />
                                <Button Command="{Binding MaximizePointsCommand}" Content="Spend Remaining Points" Padding="10,3" Margin="0,2,0,0"
                                        ToolTip="Grow the current path with the leftover points; no stats selected means the four core stats" />

                                <Separator Margin="0,10,0,8" />
                                <TextBlock Text="Placement Analysis" FontWeight="SemiBold" Margin="0,0,0,4" />
                                <Button Command="{Binding AnalyzePlacementCommand}" Content="Analyze Placement" Padding="10,3" Margin="0,0,0,8"
                                        ToolTip="Re-solves under every alternate rotation of each attached board and checks whether glyphs would see more of their stat in another socket" />

                                <ItemsControl ItemsSource="{Binding Suggestions}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#E3E3E3" BorderThickness="1" CornerRadius="3" Padding="6,4" Margin="0,0,0,6">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Description}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,4" />
                                                    <Button Content="Apply"
                                                            Command="{Binding DataContext.ApplySuggestionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}"
                                                            HorizontalAlignment="Left" Padding="10,2"
                                                            ToolTip="Apply this change to the board and re-solve, so you can see the difference" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button Command="{Binding RevertPlacementCommand}" Content="Revert Applied Change" Padding="10,3"
                                        ToolTip="Restore the layout, targets, and glyphs from before the last applied suggestion">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Style.Triggers>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="Rules">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="10,8">
                                <TextBlock FontSize="11" Foreground="#888" TextWrapping="Wrap" Margin="0,0,0,6"
                                           Text="Right-click a node on the board for its menu: mark as target, avoid (orange), or off-limits (red — never pathed through or bought). Normal and magic nodes group by stat; each rare/legendary node is its own group. The 'Any:' rows at the bottom cover every node granting that stat regardless of kind — limit 'Any: Hitpoints Max Bonus' to cap max-life nodes overall. Limit takes at most N; Minimal also prefers the FEWEST the optimal path allows (1 beats 2 at equal cost)." />
                                <DockPanel Margin="0,0,0,6">
                                    <TextBlock DockPanel.Dock="Left" Text="Filter:" VerticalAlignment="Center" FontSize="11" Margin="0,0,5,0" />
                                    <TextBox Text="{Binding RuleFilter, UpdateSourceTrigger=PropertyChanged}" FontSize="11"
                                             ToolTip="Show only rule rows whose name matches — try 'life', 'hitpoints', or 'Any:'" />
                                </DockPanel>
                                <ItemsControl ItemsSource="{Binding NodeRulesView}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:NodeRuleViewModel}">
                                            <Grid Margin="0,0,0,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" FontSize="11"
                                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding DisplayName}" />
                                                <TextBlock Grid.Column="1" Text="{Binding UsedText}" VerticalAlignment="Center"
                                                           FontSize="10" Margin="4,0,0,0"
                                                           ToolTip="Nodes of this group in the current allocation">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#4A9E4A" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsOverLimit}" Value="True">
                                                                    <Setter Property="Foreground" Value="#C0392B" />
                                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <ComboBox Grid.Column="2" ItemsSource="{Binding Modes}" SelectedItem="{Binding Mode}"
                                                          Width="72" FontSize="11" Margin="4,0,0,0" />
                                                <TextBox Grid.Column="3" Text="{Binding Limit}" Width="30" FontSize="11" Margin="4,0,0,0"
                                                         Visibility="{Binding IsLimit, Converter={StaticResource BoolToVis}}"
                                                         ToolTip="Take at most this many nodes of the group" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </DockPanel>
        </Border>

        <!-- ── Board canvas ─────────────────────────────────────────── -->
        <Grid Grid.Column="0">
        <ScrollViewer x:Name="BoardScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                      Background="{StaticResource BoardBackground}" Padding="20"
                      PreviewMouseWheel="Board_PreviewMouseWheel"
                      MouseDown="Board_MouseDown" MouseMove="Board_MouseMove" MouseUp="Board_MouseUp"
                      ToolTip="Middle-drag to pan · Ctrl+wheel to zoom · Shift+wheel to scroll sideways"
                      ToolTipService.InitialShowDelay="1200" ToolTipService.BetweenShowDelay="60000">
            <Grid Width="{Binding CanvasWidth}" Height="{Binding CanvasHeight}"
                  HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid.LayoutTransform>
                    <ScaleTransform ScaleX="{Binding Zoom}" ScaleY="{Binding Zoom}" />
                </Grid.LayoutTransform>
            <ItemsControl ItemsSource="{Binding BoardPlates}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Canvas />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="Canvas.Left" Value="{Binding CanvasLeft}" />
                        <Setter Property="Canvas.Top" Value="{Binding CanvasTop}" />
                    </Style>
                </ItemsControl.ItemContainerStyle>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:BoardPlate}">
                        <Border Width="{Binding Size}" Height="{Binding Size}"
                                Background="#282320" BorderBrush="#453C33" BorderThickness="1.5" CornerRadius="6" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <!-- Purchased-path segments, drawn under the nodes so the allocation reads as a route -->
            <ItemsControl ItemsSource="{Binding PathEdges}" IsHitTestVisible="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Canvas />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:PathEdge}">
                        <Line X1="{Binding X1}" Y1="{Binding Y1}" X2="{Binding X2}" Y2="{Binding Y2}"
                              Stroke="#9A7CCB5A" StrokeThickness="5"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <ItemsControl ItemsSource="{Binding BoardLabels}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Canvas />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="Canvas.Left" Value="{Binding CanvasLeft}" />
                        <Setter Property="Canvas.Top" Value="{Binding CanvasTop}" />
                    </Style>
                </ItemsControl.ItemContainerStyle>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:BoardLabel}">
                        <TextBlock Text="{Binding Text}" Foreground="#DFBB74" FontSize="13" FontWeight="SemiBold" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <ItemsControl ItemsSource="{Binding Cells}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Canvas />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="Canvas.Left" Value="{Binding CanvasLeft}" />
                        <Setter Property="Canvas.Top" Value="{Binding CanvasTop}" />
                    </Style>
                </ItemsControl.ItemContainerStyle>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:ParagonCellViewModel}">
                        <Button Width="26" Height="26"
                                Command="{Binding DataContext.ToggleTargetCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}"
                                MouseRightButtonUp="Cell_MouseRightButtonUp"
                                Background="Transparent" BorderThickness="0" Cursor="Hand"
                                ToolTip="{Binding ToolTipText}" ToolTipService.InitialShowDelay="150">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Grid Background="Transparent">
                                        <!-- Glyph radius highlight (see the socket's checkbox) -->
                                        <Rectangle Fill="#4A5BB8A8"
                                                   Visibility="{Binding IsInGlyphRadius, Converter={StaticResource BoolToVis}}" />
                                        <!-- Stat highlight (click a Stat Totals row) -->
                                        <Ellipse Width="24" Height="24" Fill="#66F2C14E"
                                                 Visibility="{Binding IsStatHighlighted, Converter={StaticResource BoolToVis}}" />
                                        <!-- Hover feedback -->
                                        <Ellipse x:Name="HoverRing" Width="24" Height="24" StrokeThickness="1.5"
                                                 Stroke="#88FFFFFF" Visibility="Collapsed" />
                                        <!-- Purchased-path ring -->
                                        <Ellipse Width="24" Height="24" StrokeThickness="2.5" Stroke="#7CCB5A"
                                                 Visibility="{Binding IsPurchased, Converter={StaticResource BoolToVis}}" />
                                        <!-- Just added by Spend Remaining Points / Re-analyze -->
                                        <Ellipse Width="24" Height="24" StrokeThickness="2.5" Stroke="#4FC3F7"
                                                 Visibility="{Binding IsNewlyAdded, Converter={StaticResource BoolToVis}}" />
                                        <!-- Removed by the last action — refund this one in game -->
                                        <Ellipse Width="24" Height="24" StrokeThickness="2.5" Stroke="#E27D7D"
                                                 StrokeDashArray="2.2 1.4"
                                                 Visibility="{Binding IsRemoved, Converter={StaticResource BoolToVis}}" />
                                        <!-- Target ring -->
                                        <Ellipse Width="24" Height="24" StrokeThickness="2" Stroke="White"
                                                 Visibility="{Binding IsTarget, Converter={StaticResource BoolToVis}}" />
                                        <!-- Avoid / exclude rings (right-click to cycle) -->
                                        <Ellipse Width="24" Height="24" StrokeThickness="2" Stroke="#E8A33D" StrokeDashArray="1.6 1.6"
                                                 Visibility="{Binding IsAvoided, Converter={StaticResource BoolToVis}}" />
                                        <Grid Visibility="{Binding IsExcluded, Converter={StaticResource BoolToVis}}">
                                            <Ellipse Width="24" Height="24" StrokeThickness="2" Stroke="#C0392B" />
                                            <Path Stroke="#C0392B" StrokeThickness="2" Data="M 5,5 L 21,21 M 21,5 L 5,21" />
                                        </Grid>
                                        <!-- Node shape -->
                                        <Border x:Name="Shape" Width="14" Height="14"
                                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                                RenderTransformOrigin="0.5,0.5" />
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="HoverRing" Property="Visibility" Value="Visible" />
                                        </Trigger>
                                        <DataTrigger Binding="{Binding Kind}" Value="Normal">
                                            <Setter TargetName="Shape" Property="Background" Value="{StaticResource NormalNodeBrush}" />
                                            <Setter TargetName="Shape" Property="CornerRadius" Value="7" />
                                            <Setter TargetName="Shape" Property="Width" Value="11" />
                                            <Setter TargetName="Shape" Property="Height" Value="11" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Kind}" Value="Magic">
                                            <Setter TargetName="Shape" Property="Background" Value="{StaticResource MagicNodeBrush}" />
                                            <Setter TargetName="Shape" Property="CornerRadius" Value="8" />
                                            <Setter TargetName="Shape" Property="Width" Value="15" />
                                            <Setter TargetName="Shape" Property="Height" Value="15" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Kind}" Value="Rare">
                                            <Setter TargetName="Shape" Property="Background" Value="{StaticResource RareNodeBrush}" />
                                            <Setter TargetName="Shape" Property="CornerRadius" Value="3" />
                                            <Setter TargetName="Shape" Property="Width" Value="16" />
                                            <Setter TargetName="Shape" Property="Height" Value="16" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Kind}" Value="Legendary">
                                            <Setter TargetName="Shape" Property="Background" Value="{StaticResource LegendaryNodeBrush}" />
                                            <Setter TargetName="Shape" Property="Width" Value="15" />
                                            <Setter TargetName="Shape" Property="Height" Value="15" />
                                            <Setter TargetName="Shape" Property="RenderTransform">
                                                <Setter.Value>
                                                    <RotateTransform Angle="45" />
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Kind}" Value="GlyphSocket">
                                            <Setter TargetName="Shape" Property="BorderBrush" Value="{StaticResource SocketNodeBrush}" />
                                            <Setter TargetName="Shape" Property="BorderThickness" Value="4" />
                                            <Setter TargetName="Shape" Property="CornerRadius" Value="9" />
                                            <Setter TargetName="Shape" Property="Width" Value="18" />
                                            <Setter TargetName="Shape" Property="Height" Value="18" />
                                        </DataTrigger>
                                        <!-- A socketed glyph fills its socket solid (name in the board label and tooltip) -->
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding Kind}" Value="GlyphSocket" />
                                                <Condition Binding="{Binding HasSocketedGlyph}" Value="True" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter TargetName="Shape" Property="Background" Value="{StaticResource SocketNodeBrush}" />
                                        </MultiDataTrigger>
                                        <DataTrigger Binding="{Binding Kind}" Value="Gate">
                                            <Setter TargetName="Shape" Property="BorderBrush" Value="{StaticResource GateNodeBrush}" />
                                            <Setter TargetName="Shape" Property="BorderThickness" Value="2.5" />
                                            <Setter TargetName="Shape" Property="Width" Value="16" />
                                            <Setter TargetName="Shape" Property="Height" Value="16" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Kind}" Value="Start">
                                            <Setter TargetName="Shape" Property="Background" Value="{StaticResource StartNodeBrush}" />
                                            <Setter TargetName="Shape" Property="Width" Value="15" />
                                            <Setter TargetName="Shape" Property="Height" Value="15" />
                                            <Setter TargetName="Shape" Property="RenderTransform">
                                                <Setter.Value>
                                                    <RotateTransform Angle="45" />
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            </Grid>
        </ScrollViewer>

        <!-- Quick-start card: shown until the session has boards, targets, or purchases.
             Hit-test invisible so the starter board stays clickable through it. -->
        <Border HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="460"
                Background="#F2262220" BorderBrush="#453C33" BorderThickness="1" CornerRadius="6"
                Padding="18,14" IsHitTestVisible="False"
                Visibility="{Binding ShowGettingStarted, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <StackPanel.Resources>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="#CCC" />
                        <Setter Property="FontSize" Value="12" />
                        <Setter Property="TextWrapping" Value="Wrap" />
                        <Setter Property="Margin" Value="0,0,0,6" />
                    </Style>
                </StackPanel.Resources>
                <TextBlock Text="Start a paragon plan" Foreground="#DFBB74" FontSize="15"
                           FontWeight="SemiBold" Margin="0,0,0,10" />
                <TextBlock>
                    <Run FontWeight="SemiBold" Foreground="#EEE">Import Build (Ctrl+I)</Run><Run> — copy a Maxroll or Mobalytics build URL (or planner code) to the clipboard first. Boards, glyphs, and the full allocation come in.</Run>
                </TextBlock>
                <TextBlock>
                    <Run FontWeight="SemiBold" Foreground="#EEE">Open (Ctrl+O)</Run><Run> — continue a saved planner project.</Run>
                </TextBlock>
                <TextBlock>
                    <Run FontWeight="SemiBold" Foreground="#EEE">Or plan by hand</Run><Run> — pick your class, attach boards above, click the nodes you want as targets, then Solve Path (F5) finds the cheapest route through them.</Run>
                </TextBlock>
                <TextBlock Margin="0" Foreground="#999" FontSize="11"
                           Text="Right-click any node for avoid / off-limits rules. This card disappears once you set a target, attach a board, or import." />
            </StackPanel>
        </Border>

        <!-- Zoom overlay -->
        <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,20,16"
                Background="#CC1E1A17" CornerRadius="4" Padding="8,4">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Zoom" Foreground="#BBB" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0" />
                <Slider Width="90" Minimum="0.4" Maximum="2" Value="{Binding Zoom}" VerticalAlignment="Center"
                        ToolTip="Board zoom — Ctrl+mouse wheel works too" />
                <TextBlock Text="{Binding Zoom, StringFormat={}{0:P0}}" Foreground="#BBB" FontSize="11"
                           VerticalAlignment="Center" Margin="6,0,0,0" MinWidth="32" />
                <Button Content="Fit" Click="FitZoom_Click" Padding="7,1" Margin="8,0,0,0" FontSize="11"
                        ToolTip="Zoom so the whole layout fits the view" />
                <Button Content="100%" Click="ResetZoom_Click" Padding="7,1" Margin="4,0,0,0" FontSize="11"
                        ToolTip="Reset the zoom to actual size" />
            </StackPanel>
        </Border>

        <!-- Legend overlay -->
        <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="20,0,0,16"
                Background="#CC1E1A17" CornerRadius="4" Padding="8,4">
            <Expander ExpandDirection="Up" IsExpanded="False" Foreground="#BBB">
                <Expander.Header>
                    <TextBlock Text="Legend" FontSize="11" Foreground="#BBB" />
                </Expander.Header>
                <Border Padding="2,6,2,2">
                    <Border.Resources>
                        <Style TargetType="TextBlock">
                            <Setter Property="FontSize" Value="11" />
                            <Setter Property="Foreground" Value="#CCC" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                            <Setter Property="Margin" Value="6,0,10,0" />
                        </Style>
                        <Style TargetType="Grid" x:Key="Swatch">
                            <Setter Property="Width" Value="18" />
                            <Setter Property="Height" Value="18" />
                        </Style>
                    </Border.Resources>
                    <UniformGrid Columns="2">
                        <StackPanel Orientation="Horizontal" Margin="0,1">
                            <Grid Style="{StaticResource Swatch}">
                                <Ellipse Width="9" Height="9" Fill="{StaticResource NormalNodeBrush}" />
                            </Grid>
                            <TextBlock Text="Normal" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,1">
                            <Grid Style="{StaticResource Swatch}">
                                <Ellipse Width="12" Height="12" Fill="{StaticResource MagicNodeBrush}" />
                            </Grid>
                            <TextBlock Text="Magic" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,1">
                            <Grid Style="{StaticResource Swatch}">
                                <Rectangle Width="12" Height="12" RadiusX="2" RadiusY="2" Fill="{StaticResource RareNodeBrush}" />
                            </Grid>
                            <TextBlock Text="Rare" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,1">
                            <Grid Style="{StaticResource Swatch}">
                                <Rectangle Width="10" Height="10" Fill="{StaticResource LegendaryNodeBrush}"
                                           RenderTransformOrigin="0.5,0.5">
                                    <Rectangle.RenderTransform>
                                        <RotateTransform Angle="45" />
                                    </Rectangle.RenderTransform>
                                </Rectangle>
                            </Grid>
                            <TextBlock Text="Legendary" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,1">
                            <Grid Style="{StaticResource Swatch}">
                                <Ellipse Width="13" Height="13" Stroke="{StaticResource SocketNodeBrush}" StrokeThickness="3" />
                            </Grid>
                            <TextBlock Text="Empty glyph socket" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,1">
                            <Grid Style="{StaticResource Swatch}">
                                <Ellipse Width="13" Height="13" Fill="{StaticResource SocketNodeBrush}" />
                            </Grid>
                            <TextBlock Text="Socketed glyph" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,1">
                            <Grid Style="{StaticResource Swatch}">
                                <Rectangle Width="12" Height="12" Stroke="{StaticResource GateNodeBrush}" StrokeThickness="2" />
                            </Grid>
                            <TextBlock Text="Gate" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,1">
                            <Grid Style="{StaticResource Swatch}">
                                <Rectangle Width="10" Height="10" Fill="{StaticResource StartNodeBrush}"
                                           RenderTransformOrigin="0.5,0.5">
                                    <Rectangle.RenderTransform>
                                        <RotateTransform Angle="45" />
                                    </Rectangle.RenderTransform>
                                </Rectangle>
                            </Grid>
                            <TextBlock Text="Start" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,1">
                            <Grid Style="{StaticResource Swatch}">
                                <Ellipse Width="14" Height="14" Stroke="White" StrokeThickness="2" />
                            </Grid>
                            <TextBlock Text="Target (click)" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,1">
                            <Grid Style="{StaticResource Swatch}">
                                <Ellipse Width="14" Height="14" Stroke="#7CCB5A" StrokeThickness="2.5" />
                            </Grid>
                            <TextBlock Text="Purchased path" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,1">
                            <Grid Style="{StaticResource Swatch}">
                                <Ellipse Width="14" Height="14" Stroke="#4FC3F7" StrokeThickness="2.5" />
                            </Grid>
                            <TextBlock Text="Added by last action" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,1">
                            <Grid Style="{StaticResource Swatch}">
                                <Ellipse Width="14" Height="14" Stroke="#E27D7D" StrokeThickness="2.5" StrokeDashArray="2.2 1.4" />
                            </Grid>
                            <TextBlock Text="Removed by last action" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,1">
                            <Grid Style="{StaticResource Swatch}">
                                <Ellipse Width="14" Height="14" Stroke="#E8A33D" StrokeThickness="2" StrokeDashArray="1.6 1.6" />
                            </Grid>
                            <TextBlock Text="Avoid (right-click menu)" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,1">
                            <Grid Style="{StaticResource Swatch}">
                                <Ellipse Width="14" Height="14" Stroke="#C0392B" StrokeThickness="2" />
                                <Path Stroke="#C0392B" StrokeThickness="1.6" Data="M 5,5 L 13,13 M 13,5 L 5,13" />
                            </Grid>
                            <TextBlock Text="Off-limits (right-click menu)" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,1">
                            <Grid Style="{StaticResource Swatch}">
                                <Rectangle Width="14" Height="14" Fill="#4A5BB8A8" />
                            </Grid>
                            <TextBlock Text="Glyph radius" />
                        </StackPanel>
                    </UniformGrid>
                </Border>
            </Expander>
        </Border>

        <!-- Busy overlay: dims the board and blocks clicks while the solver or an import runs -->
        <Border Background="#59141210" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
            <Border Background="#E5262220" CornerRadius="6" Padding="16,10"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <ProgressBar IsIndeterminate="True" Width="110" Height="6" VerticalAlignment="Center"
                                 Foreground="#7CCB5A" />
                    <TextBlock Text="{Binding StatusText}" Foreground="#DDD" FontSize="12" Margin="10,0,0,0"
                               VerticalAlignment="Center" MaxWidth="380" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>
        </Border>
        </Grid>
        </Grid>
    </DockPanel>
</Window>
