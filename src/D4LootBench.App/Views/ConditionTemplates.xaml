<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cond="clr-namespace:D4LootBench.App.ViewModels.Conditions"
    xmlns:views="clr-namespace:D4LootBench.App.Views">

    <BooleanToVisibilityConverter x:Key="BoolToVis" />

    <!-- Shared style for the outer condition card border -->
    <Style x:Key="ConditionCardStyle" TargetType="Border">
        <Setter Property="BorderBrush" Value="{DynamicResource App.BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="Margin" Value="0,0,0,8" />
        <Setter Property="Padding" Value="8,6" />
    </Style>

    <!-- Shared style for the condition type header TextBlock -->
    <Style x:Key="ConditionHeaderStyle" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Width" Value="130" />
        <Setter Property="Margin" Value="0,0,10,0" />
    </Style>

    <!-- Chevron toggle that expands/collapses a condition card body -->
    <Style x:Key="ConditionExpandToggleStyle" TargetType="ToggleButton">
        <Setter Property="Width" Value="18" />
        <Setter Property="Height" Value="18" />
        <Setter Property="Margin" Value="0,0,4,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Content" Value="▸" />
        <Setter Property="ToolTip" Value="Expand" />
        <Setter Property="Foreground" Value="{DynamicResource App.TextMutedBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Content" Value="▾" />
                <Setter Property="ToolTip" Value="Collapse" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource App.TextBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Spacer keeping headers of always-flat cards (Codex, Unknown) aligned with toggled ones -->
    <Style x:Key="ConditionToggleSpacerStyle" TargetType="Border">
        <Setter Property="Width" Value="18" />
        <Setter Property="Margin" Value="0,0,4,0" />
    </Style>

    <!-- ── Codex of Power ─────────────────────────────────────────────── -->
    <DataTemplate DataType="{x:Type cond:CodexConditionViewModel}">
        <Border Style="{StaticResource ConditionCardStyle}">
            <DockPanel>
                <Border Style="{StaticResource ConditionToggleSpacerStyle}" DockPanel.Dock="Left" />
                <Button DockPanel.Dock="Right" Content="✕" Padding="6,0" ToolTip="Remove condition"
                        Command="{Binding DataContext.DeleteConditionCommand,
                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                        CommandParameter="{Binding}" />
                <TextBlock Text="Codex of Power" Style="{StaticResource ConditionHeaderStyle}"
                           DockPanel.Dock="Left" />
                <TextBlock Text="Matches all Codex upgrade drops" VerticalAlignment="Center"
                           Foreground="{DynamicResource App.TextMutedBrush}"
                           FontStyle="Italic" />
            </DockPanel>
        </Border>
    </DataTemplate>

    <!-- ── Item Power ─────────────────────────────────────────────────── -->
    <DataTemplate DataType="{x:Type cond:ItemPowerConditionViewModel}">
        <Border Style="{StaticResource ConditionCardStyle}">
            <StackPanel>
                <DockPanel>
                    <ToggleButton Style="{StaticResource ConditionExpandToggleStyle}"
                                  IsChecked="{Binding IsExpanded}" DockPanel.Dock="Left" />
                    <Button DockPanel.Dock="Right" Content="✕" Padding="6,0" ToolTip="Remove condition"
                            Command="{Binding DataContext.DeleteConditionCommand,
                                      RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CommandParameter="{Binding}" />
                    <TextBlock Text="{Binding TypeName}" Style="{StaticResource ConditionHeaderStyle}"
                               DockPanel.Dock="Left" />
                    <TextBlock Text="{Binding Summary}" VerticalAlignment="Center"
                               Foreground="{DynamicResource App.TextMutedBrush}" />
                </DockPanel>
                <StackPanel Margin="0,6,0,0"
                            Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">
                    <DockPanel>
                        <Label Content="Min:" DockPanel.Dock="Left" Padding="0,0,4,0" VerticalAlignment="Center" />
                        <TextBox DockPanel.Dock="Left" Width="70" Margin="0,0,16,0"
                                 Text="{Binding Minimum, UpdateSourceTrigger=PropertyChanged}" />
                        <Label Content="Max:" DockPanel.Dock="Left" Padding="0,0,4,0" VerticalAlignment="Center" />
                        <TextBox DockPanel.Dock="Left" Width="70"
                                 Text="{Binding Maximum, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Set to 0 for no upper bound (game cap 900)" />
                        <TextBlock Text="(0 = no upper bound)" Margin="8,0,0,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource App.TextMutedBrush}"
                                   FontSize="11" />
                    </DockPanel>
                    <TextBlock Text="Clamped to game cap 900"
                               Margin="0,4,0,0"
                               FontSize="11"
                               Foreground="#C88A00">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding MaximumWasClamped}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </StackPanel>
        </Border>
    </DataTemplate>

    <!-- ── Greater Affix ──────────────────────────────────────────────── -->
    <DataTemplate DataType="{x:Type cond:GreaterAffixConditionViewModel}">
        <Border Style="{StaticResource ConditionCardStyle}">
            <StackPanel>
                <DockPanel>
                    <ToggleButton Style="{StaticResource ConditionExpandToggleStyle}"
                                  IsChecked="{Binding IsExpanded}" DockPanel.Dock="Left" />
                    <Button DockPanel.Dock="Right" Content="✕" Padding="6,0" ToolTip="Remove condition"
                            Command="{Binding DataContext.DeleteConditionCommand,
                                      RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CommandParameter="{Binding}" />
                    <TextBlock Text="{Binding TypeName}" Style="{StaticResource ConditionHeaderStyle}"
                               DockPanel.Dock="Left" />
                    <TextBlock Text="{Binding Summary}" VerticalAlignment="Center"
                               Foreground="{DynamicResource App.TextMutedBrush}" />
                </DockPanel>
                <DockPanel Margin="0,6,0,0"
                           Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">
                    <Label Content="Minimum:" DockPanel.Dock="Left" Padding="0,0,4,0" VerticalAlignment="Center" />
                    <TextBox DockPanel.Dock="Left" Width="70"
                             Text="{Binding MinimumCount, UpdateSourceTrigger=PropertyChanged}" />
                </DockPanel>
            </StackPanel>
        </Border>
    </DataTemplate>

    <!-- ── Item Properties ────────────────────────────────────────────── -->
    <DataTemplate DataType="{x:Type cond:ItemPropertiesConditionViewModel}">
        <Border Style="{StaticResource ConditionCardStyle}">
            <StackPanel>
                <DockPanel>
                    <ToggleButton Style="{StaticResource ConditionExpandToggleStyle}"
                                  IsChecked="{Binding IsExpanded}" DockPanel.Dock="Left" />
                    <Button DockPanel.Dock="Right" Content="✕" Padding="6,0" ToolTip="Remove condition"
                            Command="{Binding DataContext.DeleteConditionCommand,
                                      RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CommandParameter="{Binding}" />
                    <TextBlock Text="{Binding TypeName}" Style="{StaticResource ConditionHeaderStyle}"
                               DockPanel.Dock="Left" />
                    <TextBlock Text="{Binding Summary}" VerticalAlignment="Center"
                               Foreground="{DynamicResource App.TextMutedBrush}" />
                </DockPanel>
                <StackPanel Margin="0,6,0,0"
                            Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">
                    <WrapPanel>
                        <CheckBox Content="None"      IsChecked="{Binding IsNone}"      Margin="0,0,10,2"
                                  ToolTip="No property requirement" />
                        <CheckBox Content="Ancestral" IsChecked="{Binding IsAncestral}" Margin="0,0,10,2" />
                        <CheckBox Content="Mythic"    IsChecked="{Binding IsMythic}"    Margin="0,0,10,2" />
                    </WrapPanel>
                    <!-- Show raw mask when bits outside the known flags are set -->
                    <TextBlock FontSize="11" Margin="0,4,0,0"
                               Foreground="{DynamicResource App.TextMutedBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasUnknownBits}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                        <Run Text="Raw mask value: " />
                        <Run Text="{Binding PropertyMask, Mode=OneWay}" />
                        <Run Text="(has unrecognized bits — preserved as-is)" />
                    </TextBlock>
                </StackPanel>
            </StackPanel>
        </Border>
    </DataTemplate>

    <!-- ── Rarity ─────────────────────────────────────────────────────── -->
    <DataTemplate DataType="{x:Type cond:RarityConditionViewModel}">
        <Border Style="{StaticResource ConditionCardStyle}">
            <StackPanel>
                <DockPanel>
                    <ToggleButton Style="{StaticResource ConditionExpandToggleStyle}"
                                  IsChecked="{Binding IsExpanded}" DockPanel.Dock="Left" />
                    <Button DockPanel.Dock="Right" Content="✕" Padding="6,0" ToolTip="Remove condition"
                            Command="{Binding DataContext.DeleteConditionCommand,
                                      RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CommandParameter="{Binding}" />
                    <TextBlock Text="{Binding TypeName}" Style="{StaticResource ConditionHeaderStyle}"
                               DockPanel.Dock="Left" />
                    <TextBlock Text="{Binding Summary}" VerticalAlignment="Center"
                               Foreground="{DynamicResource App.TextMutedBrush}" />
                </DockPanel>
                <WrapPanel Margin="0,6,0,0"
                           Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">
                    <CheckBox Content="Common"    IsChecked="{Binding Common}"    Margin="0,0,10,2" />
                    <CheckBox Content="Magic"     IsChecked="{Binding Magic}"     Margin="0,0,10,2" />
                    <CheckBox Content="Rare"      IsChecked="{Binding Rare}"      Margin="0,0,10,2" />
                    <CheckBox Content="Legendary" IsChecked="{Binding Legendary}" Margin="0,0,10,2" />
                    <CheckBox Content="Unique"    IsChecked="{Binding Unique}"    Margin="0,0,10,2" />
                    <CheckBox Content="Mythic"    IsChecked="{Binding Mythic}"    Margin="0,0,10,2" />
                    <CheckBox Content="Talisman"  IsChecked="{Binding Talisman}"  Margin="0,0,10,2" />
                </WrapPanel>
            </StackPanel>
        </Border>
    </DataTemplate>

    <!-- ── Item Type ──────────────────────────────────────────────────── -->
    <DataTemplate DataType="{x:Type cond:ItemTypeConditionViewModel}">
        <Border Style="{StaticResource ConditionCardStyle}">
            <StackPanel>
                <DockPanel>
                    <ToggleButton Style="{StaticResource ConditionExpandToggleStyle}"
                                  IsChecked="{Binding IsExpanded}" DockPanel.Dock="Left" />
                    <Button DockPanel.Dock="Right" Content="✕" Padding="6,0" ToolTip="Remove condition"
                            Command="{Binding DataContext.DeleteConditionCommand,
                                      RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CommandParameter="{Binding}" />
                    <TextBlock Text="{Binding TypeName}" Style="{StaticResource ConditionHeaderStyle}"
                               DockPanel.Dock="Left" />
                    <TextBlock Text="{Binding Summary}" VerticalAlignment="Center"
                               Foreground="{DynamicResource App.TextMutedBrush}" />
                </DockPanel>
                <StackPanel Margin="0,6,0,0"
                            Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">
                    <views:ItemPickerControl DataContext="{Binding Picker}" />
                </StackPanel>
            </StackPanel>
        </Border>
    </DataTemplate>

    <!-- ── Required Affixes ───────────────────────────────────────────── -->
    <DataTemplate DataType="{x:Type cond:AffixConditionViewModel}">
        <Border Style="{StaticResource ConditionCardStyle}">
            <StackPanel>
                <DockPanel>
                    <ToggleButton Style="{StaticResource ConditionExpandToggleStyle}"
                                  IsChecked="{Binding IsExpanded}" DockPanel.Dock="Left" />
                    <Button DockPanel.Dock="Right" Content="✕" Padding="6,0" ToolTip="Remove condition"
                            Command="{Binding DataContext.DeleteConditionCommand,
                                      RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CommandParameter="{Binding}" />
                    <Button DockPanel.Dock="Right" Content="⇄ Optional" Padding="6,0" Margin="0,0,4,0"
                            ToolTip="Convert to Optional Affixes, keeping affixes, count, and greater-affix flags. Disabled while the rule already has an Optional Affixes condition."
                            ToolTipService.ShowOnDisabled="True"
                            Command="{Binding DataContext.ConvertAffixConditionCommand,
                                      RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CommandParameter="{Binding}" />
                    <TextBlock Text="{Binding TypeName}" Style="{StaticResource ConditionHeaderStyle}"
                               DockPanel.Dock="Left" />
                    <TextBlock Text="{Binding Summary}" VerticalAlignment="Center"
                               Foreground="{DynamicResource App.TextMutedBrush}" />
                </DockPanel>
                <StackPanel Margin="0,6,0,0"
                            Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">
                    <DockPanel Margin="0,0,0,6">
                        <Label Content="Required count:" DockPanel.Dock="Left" Padding="0,0,4,0"
                               VerticalAlignment="Center" />
                        <TextBox DockPanel.Dock="Left" Width="70"
                                 Text="{Binding MinimumCount, UpdateSourceTrigger=PropertyChanged}" />
                    </DockPanel>
                    <views:ItemPickerControl DataContext="{Binding Picker}" />
                    <DockPanel Margin="0,8,0,2" LastChildFill="False">
                        <ToggleButton Style="{StaticResource ConditionExpandToggleStyle}"
                                      IsChecked="{Binding IsGreaterExpanded}" DockPanel.Dock="Left"
                                      ToolTip="Flag selected affixes as required Greater Affixes" />
                        <TextBlock FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"
                                   Foreground="{DynamicResource App.TextMutedBrush}"
                                   DockPanel.Dock="Left">
                            <Run Text="Greater Affixes" />
                            <Run Text="{Binding GreaterPicker.SelectionCountDisplay, Mode=OneWay}" />
                        </TextBlock>
                    </DockPanel>
                    <StackPanel Visibility="{Binding IsGreaterExpanded, Converter={StaticResource BoolToVis}}">
                        <views:ItemPickerControl DataContext="{Binding GreaterPicker}" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Border>
    </DataTemplate>

    <!-- ── Optional Affixes ───────────────────────────────────────────── -->
    <DataTemplate DataType="{x:Type cond:OptionalAffixConditionViewModel}">
        <Border Style="{StaticResource ConditionCardStyle}">
            <StackPanel>
                <DockPanel>
                    <ToggleButton Style="{StaticResource ConditionExpandToggleStyle}"
                                  IsChecked="{Binding IsExpanded}" DockPanel.Dock="Left" />
                    <Button DockPanel.Dock="Right" Content="✕" Padding="6,0" ToolTip="Remove condition"
                            Command="{Binding DataContext.DeleteConditionCommand,
                                      RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CommandParameter="{Binding}" />
                    <Button DockPanel.Dock="Right" Content="⇄ Required" Padding="6,0" Margin="0,0,4,0"
                            ToolTip="Convert to Required Affixes, keeping affixes and count (a count of 0 becomes 1). Disabled while the rule already has a Required Affixes condition."
                            ToolTipService.ShowOnDisabled="True"
                            Command="{Binding DataContext.ConvertAffixConditionCommand,
                                      RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CommandParameter="{Binding}" />
                    <TextBlock Text="{Binding TypeName}" Style="{StaticResource ConditionHeaderStyle}"
                               DockPanel.Dock="Left" />
                    <TextBlock Text="{Binding Summary}" VerticalAlignment="Center"
                               Foreground="{DynamicResource App.TextMutedBrush}" />
                </DockPanel>
                <StackPanel Margin="0,6,0,0"
                            Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">
                    <DockPanel Margin="0,0,0,6">
                        <Label Content="Minimum matching:" DockPanel.Dock="Left" Padding="0,0,4,0"
                               VerticalAlignment="Center" />
                        <TextBox DockPanel.Dock="Left" Width="70"
                                 Text="{Binding MinimumCount, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="0 = match any" />
                        <TextBlock Text="(0 = any)" Margin="8,0,0,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource App.TextMutedBrush}"
                                   FontSize="11" />
                    </DockPanel>
                    <views:ItemPickerControl DataContext="{Binding Picker}" />
                </StackPanel>
            </StackPanel>
        </Border>
    </DataTemplate>

    <!-- ── Specific Unique ────────────────────────────────────────────── -->
    <DataTemplate DataType="{x:Type cond:SpecificUniqueConditionViewModel}">
        <Border Style="{StaticResource ConditionCardStyle}">
            <StackPanel>
                <DockPanel>
                    <ToggleButton Style="{StaticResource ConditionExpandToggleStyle}"
                                  IsChecked="{Binding IsExpanded}" DockPanel.Dock="Left" />
                    <Button DockPanel.Dock="Right" Content="✕" Padding="6,0" ToolTip="Remove condition"
                            Command="{Binding DataContext.DeleteConditionCommand,
                                      RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CommandParameter="{Binding}" />
                    <TextBlock Text="{Binding TypeName}" Style="{StaticResource ConditionHeaderStyle}"
                               DockPanel.Dock="Left" />
                    <TextBlock Text="{Binding Summary}" VerticalAlignment="Center"
                               Foreground="{DynamicResource App.TextMutedBrush}" />
                </DockPanel>
                <StackPanel Margin="0,6,0,0"
                            Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">
                    <views:ItemPickerControl DataContext="{Binding Picker}" />
                </StackPanel>
            </StackPanel>
        </Border>
    </DataTemplate>

    <!-- ── Talisman Set ───────────────────────────────────────────────── -->
    <DataTemplate DataType="{x:Type cond:TalismanSetConditionViewModel}">
        <Border Style="{StaticResource ConditionCardStyle}">
            <StackPanel>
                <DockPanel>
                    <ToggleButton Style="{StaticResource ConditionExpandToggleStyle}"
                                  IsChecked="{Binding IsExpanded}" DockPanel.Dock="Left" />
                    <Button DockPanel.Dock="Right" Content="✕" Padding="6,0" ToolTip="Remove condition"
                            Command="{Binding DataContext.DeleteConditionCommand,
                                      RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CommandParameter="{Binding}" />
                    <TextBlock Text="{Binding TypeName}" Style="{StaticResource ConditionHeaderStyle}"
                               DockPanel.Dock="Left" />
                    <TextBlock Text="{Binding Summary}" VerticalAlignment="Center"
                               Foreground="{DynamicResource App.TextMutedBrush}" />
                </DockPanel>
                <StackPanel Margin="0,6,0,0"
                            Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Sets" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,2"
                               Foreground="{DynamicResource App.TextMutedBrush}" />
                    <views:ItemPickerControl DataContext="{Binding SetPicker}" />
                    <TextBlock Text="Specific Items" FontSize="11" FontWeight="SemiBold" Margin="0,8,0,2"
                               Foreground="{DynamicResource App.TextMutedBrush}" />
                    <views:ItemPickerControl DataContext="{Binding ItemPicker}" />
                </StackPanel>
            </StackPanel>
        </Border>
    </DataTemplate>

    <!-- ── Unknown (read-only passthrough) ───────────────────────────── -->
    <DataTemplate DataType="{x:Type cond:UnknownConditionViewModel}">
        <Border Style="{StaticResource ConditionCardStyle}">
            <DockPanel>
                <Border Style="{StaticResource ConditionToggleSpacerStyle}" DockPanel.Dock="Left" />
                <Button DockPanel.Dock="Right" Content="✕" Padding="6,0" ToolTip="Remove condition"
                        Command="{Binding DataContext.DeleteConditionCommand,
                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                        CommandParameter="{Binding}" />
                <TextBlock Text="{Binding TypeName}" FontWeight="SemiBold" VerticalAlignment="Center"
                           MinWidth="120" Margin="0,0,10,0" DockPanel.Dock="Left" />
                <TextBlock VerticalAlignment="Center"
                           Foreground="{DynamicResource App.TextMutedBrush}"
                           FontStyle="Italic">
                    <Run Text="{Binding Summary, Mode=OneWay}" />
                    <Run Text="— preserved as-is" />
                </TextBlock>
            </DockPanel>
        </Border>
    </DataTemplate>

</ResourceDictionary>
