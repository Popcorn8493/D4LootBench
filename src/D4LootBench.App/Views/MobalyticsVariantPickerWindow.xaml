<Window
    x:Class="D4LootBench.App.Views.MobalyticsVariantPickerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Choose Build Variant"
    Height="300" Width="440"
    WindowStartupLocation="CenterOwner"
    ResizeMode="NoResize"
    ShowInTaskbar="False">

    <DockPanel Margin="12">
        <TextBlock DockPanel.Dock="Top" Margin="0,0,0,8"
                   Text="This build guide has multiple paragon variants — pick one to import:" />
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Import" Width="80" Margin="0,0,8,0" IsDefault="True" Click="OnImport" />
            <Button Content="Cancel" Width="80" IsCancel="True" />
        </StackPanel>
        <ListBox x:Name="VariantList" MouseDoubleClick="OnImport" />
    </DockPanel>
</Window>
