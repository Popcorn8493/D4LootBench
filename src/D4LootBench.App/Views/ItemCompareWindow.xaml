<Window
    x:Class="D4LootBench.App.Views.ItemCompareWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:D4LootBench.App.ViewModels"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance Type=vm:ItemCompareViewModel, IsDesignTimeCreatable=False}"
    Title="Item Compare — D4LootBench"
    Width="940" Height="680"
    MinWidth="720" MinHeight="520"
    WindowStartupLocation="CenterOwner"
    ShowInTaskbar="False"
    ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <DataTemplate x:Key="CandidateTemplate" DataType="{x:Type vm:CandidateItemViewModel}">
            <Border BorderThickness="1" CornerRadius="4" Padding="10" Margin="4">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderBrush" Value="#D4D4D4" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsWinner}" Value="True">
                                <Setter Property="BorderBrush" Value="#4A9E4A" />
                                <Setter Property="BorderThickness" Value="2" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <DockPanel Margin="0,0,0,6">
                            <Button DockPanel.Dock="Right" Content="Scan" Padding="8,1" Margin="4,0,0,0" FontSize="11"
                                    Command="{Binding DataContext.ScanItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"
                                    ToolTip="Identify this item from a tooltip screenshot on the clipboard (snip it with Win+Shift+S first) — Windows OCR reads the name, slot, and stat lines" />
                            <TextBox Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}"
                                     FontWeight="SemiBold"
                                     ToolTip="A nickname for this item, used in the verdict and as its name in the gear library" />
                        </DockPanel>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="52" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Saved:" VerticalAlignment="Center" FontSize="11" />
                            <ComboBox Grid.Column="1" FontSize="11" MaxDropDownHeight="320"
                                      ItemsSource="{Binding DataContext.SavedGearNames, RelativeSource={RelativeSource AncestorType=Window}}"
                                      SelectedItem="{Binding SelectedSavedName}"
                                      ToolTip="Your gear library — pick an entry and Load it into this side (e.g. the piece you have equipped)" />
                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                <Button Content="Load" Padding="6,1" Margin="4,0,0,0" FontSize="11"
                                        Command="{Binding DataContext.LoadSavedCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"
                                        ToolTip="Fill this side from the picked gear-library entry" />
                                <Button Content="Save" Padding="6,1" Margin="4,0,0,0" FontSize="11"
                                        Command="{Binding DataContext.SaveItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"
                                        ToolTip="Save this item to the gear library under its nickname (same name overwrites)" />
                                <Button Content="✕" Padding="6,1" Margin="4,0,0,0" FontSize="11"
                                        Command="{Binding DataContext.DeleteSavedCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"
                                        ToolTip="Delete the picked entry from the gear library" />
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="52" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Slot:" VerticalAlignment="Center" FontSize="11" />
                            <ComboBox Grid.Column="1" FontSize="11"
                                      ItemsSource="{Binding DataContext.ItemTypeOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                      SelectedItem="{Binding SelectedItemType}"
                                      DisplayMemberPath="Name" TextSearch.TextPath="Name"
                                      ToolTip="The item's slot/type — finds the matching filter rule (the guide's wish list for this slot)" />
                        </Grid>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="52" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Unique:" VerticalAlignment="Center" FontSize="11" />
                            <ComboBox Grid.Column="1" FontSize="11" MaxDropDownHeight="320"
                                      ItemsSource="{Binding DataContext.UniqueOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                      SelectedItem="{Binding SelectedUnique}"
                                      DisplayMemberPath="Name" TextSearch.TextPath="Name"
                                      ToolTip="Pick the unique if this drop is one — with the list open, type a name to jump to it">
                                <ComboBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <VirtualizingStackPanel />
                                    </ItemsPanelTemplate>
                                </ComboBox.ItemsPanel>
                            </ComboBox>
                        </Grid>
                        <DockPanel Margin="0,0,0,3">
                            <Button DockPanel.Dock="Right" Content="+" Width="20" FontSize="11" Padding="0"
                                    Command="{Binding AddAffixRowCommand}"
                                    ToolTip="Add another affix line" />
                            <TextBlock Text="Affixes (value optional, GA = Greater Affix):"
                                       FontSize="11" Foreground="#888" VerticalAlignment="Center" />
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding AffixRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:AffixRowViewModel}">
                                    <Grid Margin="0,0,0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="52" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ComboBox FontSize="11" MaxDropDownHeight="320"
                                                  ItemsSource="{Binding DataContext.AffixOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  SelectedItem="{Binding SelectedAffix}"
                                                  DisplayMemberPath="Name" TextSearch.TextPath="Name"
                                                  ToolTip="With the list open, type an affix name to jump to it">
                                            <ComboBox.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <VirtualizingStackPanel />
                                                </ItemsPanelTemplate>
                                            </ComboBox.ItemsPanel>
                                        </ComboBox>
                                        <TextBox Grid.Column="1" Text="{Binding ValueText, UpdateSourceTrigger=PropertyChanged}"
                                                 FontSize="11" Margin="4,0,0,0"
                                                 ToolTip="The rolled value — used to compare rolls of the same affix and to weigh paragon threshold deficits. Leave empty on a GA line: the roll is fixed at max × 1.5 and fills in automatically from the other item's roll on Compare." />
                                        <CheckBox Grid.Column="2" IsChecked="{Binding IsGreater}" Content="GA"
                                                  FontSize="11" VerticalAlignment="Center" Margin="6,0,0,0"
                                                  ToolTip="Greater Affix — rolls are deterministic (max × 1.5), so the value derives automatically when left empty" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <DockPanel Margin="0,4,0,3">
                            <Button DockPanel.Dock="Right" Content="+" Width="20" FontSize="11" Padding="0"
                                    Command="{Binding AddTransfiguredRowCommand}"
                                    ToolTip="Add another transfigured stat line" />
                            <TextBlock Text="Transfigured stats (Horadric, no GA):"
                                       FontSize="11" Foreground="#888" VerticalAlignment="Center" />
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding TransfiguredRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:AffixRowViewModel}">
                                    <Grid Margin="0,0,0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="52" />
                                        </Grid.ColumnDefinitions>
                                        <ComboBox FontSize="11" MaxDropDownHeight="320"
                                                  ItemsSource="{Binding DataContext.AffixOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  SelectedItem="{Binding SelectedAffix}"
                                                  DisplayMemberPath="Name" TextSearch.TextPath="Name"
                                                  ToolTip="A stat granted by Horadric transfiguration — scores like an affix but can never be a Greater Affix">
                                            <ComboBox.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <VirtualizingStackPanel />
                                                </ItemsPanelTemplate>
                                            </ComboBox.ItemsPanel>
                                        </ComboBox>
                                        <TextBox Grid.Column="1" Text="{Binding ValueText, UpdateSourceTrigger=PropertyChanged}"
                                                 FontSize="11" Margin="4,0,0,0"
                                                 ToolTip="The transfigured stat's value" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                        <TextBlock Text="{Binding ResultText}" TextWrapping="Wrap" FontSize="11"
                                   FontFamily="Cascadia Code, Consolas, Courier New" />
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <DockPanel Margin="12">
        <TextBlock DockPanel.Dock="Top" Text="{Binding ReferenceSummary}" TextWrapping="Wrap"
                   Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                   FontSize="11" Margin="0,0,0,4" />
        <TextBlock DockPanel.Dock="Top" Text="{Binding StatusText}" TextWrapping="Wrap"
                   FontSize="11" Margin="0,0,0,8" />

        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <Button DockPanel.Dock="Right" Content="Compare" Width="110" Height="28"
                    Command="{Binding CompareCommand}" IsDefault="True" />
            <TextBlock Text="{Binding Verdict}" TextWrapping="Wrap" FontWeight="SemiBold"
                       VerticalAlignment="Center" Margin="0,0,10,0" />
        </DockPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ContentControl Content="{Binding ItemA}" ContentTemplate="{StaticResource CandidateTemplate}" />
            <ContentControl Grid.Column="1" Content="{Binding ItemB}" ContentTemplate="{StaticResource CandidateTemplate}" />
        </Grid>
    </DockPanel>
</Window>
