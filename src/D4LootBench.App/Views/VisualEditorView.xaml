<UserControl
    x:Class="D4LootBench.App.Views.VisualEditorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:D4LootBench.App.ViewModels"
    xmlns:behaviors="clr-namespace:D4LootBench.App.Behaviors"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance Type=vm:VisualEditorViewModel, IsDesignTimeCreatable=False}">

    <Grid x:Name="EditorGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" MinWidth="200" />
            <ColumnDefinition Width="6" />
            <ColumnDefinition Width="*" MinWidth="340" />
        </Grid.ColumnDefinitions>

        <!-- ── Rule List (left panel) ───────────────────────────────── -->
        <DockPanel Grid.Column="0">

            <!-- Filter name + rule count + class filter -->
            <DockPanel DockPanel.Dock="Top" Margin="4,4,4,2" LastChildFill="True">
                <ComboBox ItemsSource="{x:Static vm:VisualEditorViewModel.PlayerClasses}"
                          SelectedItem="{Binding SelectedClass}"
                          DockPanel.Dock="Right"
                          Width="118"
                          ToolTip="Filter skills and affixes by class (UI only — not saved in the filter)" />
                <TextBlock Text="{Binding RuleCountDisplay}"
                           VerticalAlignment="Center"
                           FontSize="11"
                           Foreground="{DynamicResource App.TextMutedBrush}"
                           DockPanel.Dock="Right"
                           Margin="0,0,6,0" />
                <TextBox Text="{Binding FilterName, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Filter name"
                         Margin="0,0,4,0" />
            </DockPanel>

            <!-- Plain panel, not ToolBarTray/ToolBar: the Fluent theme's ToolBar template
                 collapses this row to a few clipped pixels inside a DockPanel. -->
            <Border DockPanel.Dock="Top" Padding="4,2,4,4">
                <StackPanel Orientation="Horizontal">
                    <StackPanel.Resources>
                        <Style x:Key="RuleToolButton" TargetType="Button">
                            <Setter Property="Width" Value="28" />
                            <Setter Property="Height" Value="26" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,0,2,0" />
                            <Setter Property="FontSize" Value="14" />
                            <Setter Property="FontWeight" Value="Bold" />
                        </Style>
                        <Style x:Key="RuleToolDivider" TargetType="Border">
                            <Setter Property="Width" Value="1" />
                            <Setter Property="Height" Value="18" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                            <Setter Property="Background" Value="{DynamicResource App.DividerBrush}" />
                            <Setter Property="Margin" Value="4,0,6,0" />
                        </Style>
                    </StackPanel.Resources>
                    <Button Content="+" Command="{Binding AddRuleCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource RuleToolButton}">
                                <Setter Property="ToolTip" Value="Add rule" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAtRuleLimit}" Value="True">
                                        <Setter Property="ToolTip" Value="Maximum 25 rules per filter (game-enforced)" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="−" Command="{Binding DeleteRuleCommand}" ToolTip="Delete rule (Del)" Style="{StaticResource RuleToolButton}" />
                    <Button Content="&#xE8C8;" Command="{Binding DuplicateRuleCommand}"
                            ToolTip="Duplicate rule (Ctrl+D)"
                            Style="{StaticResource RuleToolButton}" FontSize="13" FontWeight="Normal" FontFamily="Segoe MDL2 Assets" />
                    <Border Style="{StaticResource RuleToolDivider}" />
                    <Button Content="↑" Command="{Binding MoveUpCommand}"   ToolTip="Move up (or drag rules to reorder)"   Style="{StaticResource RuleToolButton}" />
                    <Button Content="↓" Command="{Binding MoveDownCommand}" ToolTip="Move down (or drag rules to reorder)" Style="{StaticResource RuleToolButton}" />
                    <Border Style="{StaticResource RuleToolDivider}" />
                    <Button Content="&#xEA99;" Command="{Binding RemoveDuplicateRulesCommand}"
                            ToolTip="Clean up — find and remove rules that duplicate an earlier rule"
                            Style="{StaticResource RuleToolButton}" FontSize="13" FontWeight="Normal" FontFamily="Segoe MDL2 Assets" />
                    <Button Content="Combine" Command="{Binding CombineRulesCommand}"
                            ToolTip="Combine rules that differ only in one item type, unique, or affix list (the merge suggestions Validate reports)"
                            Height="26" Padding="8,0" />
                </StackPanel>
            </Border>

            <ListBox x:Name="RuleList"
                     ItemsSource="{Binding Rules}"
                     SelectedItem="{Binding SelectedRule}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     BorderThickness="0,1,1,0"
                     AllowDrop="True"
                     PreviewMouseLeftButtonDown="RuleList_PreviewMouseLeftButtonDown"
                     PreviewMouseMove="RuleList_PreviewMouseMove"
                     DragOver="RuleList_DragOver"
                     Drop="RuleList_Drop">
                <!-- The Fluent theme's roomy ListBoxItem padding halves how many rules fit — keep rows compact -->
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="6,4" />
                        <Setter Property="MinHeight" Value="0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.InputBindings>
                    <KeyBinding Key="Delete" Command="{Binding DeleteRuleCommand}" />
                    <KeyBinding Key="D" Modifiers="Control" Command="{Binding DuplicateRuleCommand}" />
                </ListBox.InputBindings>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:FilterRuleViewModel}">
                        <DockPanel Margin="4,2" LastChildFill="True">
                            <Rectangle Width="10" Height="10" Margin="0,0,5,0"
                                       Fill="{Binding DisplayBrush}"
                                       Stroke="{DynamicResource App.BorderBrush}"
                                       StrokeThickness="0.5"
                                       DockPanel.Dock="Left" VerticalAlignment="Center" />
                            <CheckBox IsChecked="{Binding IsEnabled}"
                                      DockPanel.Dock="Left" Margin="0,0,5,0"
                                      VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Name}"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" />
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- ── Splitter ──────────────────────────────────────────────── -->
        <GridSplitter x:Name="RuleListSplitter" Grid.Column="1"
                      HorizontalAlignment="Stretch"
                      Width="6"
                      ShowsPreview="True"
                      ResizeBehavior="PreviousAndNext"
                      Background="{DynamicResource App.SplitterBrush}">
            <GridSplitter.Template>
                <ControlTemplate TargetType="GridSplitter">
                    <Grid Background="{TemplateBinding Background}">
                        <Rectangle Width="2" Fill="{DynamicResource App.DividerBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Stretch"
                                   Margin="0,40" RadiusX="1" RadiusY="1" />
                    </Grid>
                </ControlTemplate>
            </GridSplitter.Template>
        </GridSplitter>

        <!-- ── Rule Editor (right panel) ────────────────────────────── -->
        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
            <ContentControl Content="{Binding SelectedRule}">

                <!-- No-selection placeholder -->
                <ContentControl.Style>
                    <Style TargetType="ContentControl">
                        <Style.Triggers>
                            <Trigger Property="Content" Value="{x:Null}">
                                <Setter Property="ContentTemplate">
                                    <Setter.Value>
                                        <DataTemplate>
                                            <TextBlock Text="Select a rule to edit."
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource App.TextMutedBrush}" />
                                        </DataTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>

                <!-- Rule editor template (DataContext = FilterRuleViewModel) -->
                <ContentControl.Resources>
                    <DataTemplate DataType="{x:Type vm:FilterRuleViewModel}">
                        <StackPanel Margin="14,10">

                            <!-- Name -->
                            <Label Content="Name" Padding="0,0,0,2" />
                            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                     MaxLength="24"
                                     Margin="0,0,0,10" />

                            <!-- Enabled + Visibility -->
                            <DockPanel Margin="0,0,0,10">
                                <CheckBox Content="Enabled"
                                          IsChecked="{Binding IsEnabled}"
                                          VerticalAlignment="Center"
                                          Margin="0,0,20,0"
                                          DockPanel.Dock="Left" />
                                <Label Content="Visibility"
                                       VerticalAlignment="Center"
                                       Padding="0,0,6,0"
                                       DockPanel.Dock="Left" />
                                <ComboBox ItemsSource="{x:Static vm:FilterRuleViewModel.VisibilityValues}"
                                          SelectedItem="{Binding Visibility}"
                                          Width="120"
                                          HorizontalAlignment="Left" />
                            </DockPanel>

                            <!-- Color section — only active when Visibility = Recolor -->
                            <StackPanel IsEnabled="{Binding IsRecolor}">
                                <Label Content="Color" Padding="0,0,0,2" />

                                <!-- Swatch palette + Suggest button -->
                                <WrapPanel Margin="0,0,0,6">
                                    <ItemsControl ItemsSource="{x:Static vm:FilterRuleViewModel.StandardColors}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:NamedColor}">
                                                <Button Command="{Binding DataContext.SelectColorCommand,
                                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding Argb}"
                                                        ToolTip="{Binding Name}"
                                                        Padding="2" Margin="0,0,3,0"
                                                        Width="30" Height="30"
                                                        HorizontalContentAlignment="Stretch"
                                                        VerticalContentAlignment="Stretch">
                                                    <Rectangle Fill="{Binding Brush}" />
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <Button Content="Suggest"
                                            Command="{Binding GenerateDistinctColorCommand}"
                                            ToolTip="Generate a color visually distinct from all other rule colors"
                                            Padding="8,2" Margin="6,0,0,0"
                                            VerticalAlignment="Center" />
                                    <Button Content="Pick…"
                                            Command="{Binding PickColorCommand}"
                                            ToolTip="Open color picker"
                                            Padding="8,2" Margin="6,0,0,0"
                                            VerticalAlignment="Center" />
                                </WrapPanel>

                                <!-- Current color preview + ABGR hex -->
                                <DockPanel Margin="0,0,0,14">
                                    <Rectangle Width="28" Height="28"
                                               Fill="{Binding WpfBrush}"
                                               Stroke="{DynamicResource App.BorderBrush}"
                                               StrokeThickness="0.5"
                                               DockPanel.Dock="Left" Margin="0,0,8,0" />
                                    <Label Content="RGB hex:"
                                           VerticalAlignment="Center"
                                           Padding="0,0,6,0"
                                           DockPanel.Dock="Left" />
                                    <TextBox Text="{Binding ColorHex, UpdateSourceTrigger=LostFocus}"
                                             FontFamily="Cascadia Code, Consolas, Courier New"
                                             MaxLength="8" Width="90"
                                             VerticalAlignment="Center"
                                             HorizontalAlignment="Left" />
                                </DockPanel>
                            </StackPanel>

                            <Separator Margin="0,0,0,10" />

                            <!-- Conditions header + add control -->
                            <DockPanel Margin="0,0,0,6">
                                <TextBlock Text="Conditions"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           DockPanel.Dock="Left" />
                                <Button Content="↶ Undo Delete"
                                        Command="{Binding UndoDeleteConditionCommand}"
                                        ToolTip="{Binding LastDeletedConditionTypeName, StringFormat=Restore the {0} condition you just removed}"
                                        Padding="8,2"
                                        Margin="0,0,12,0"
                                        DockPanel.Dock="Right">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasUndoableDelete}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Content="+ Add"
                                        Command="{Binding AddConditionCommand}"
                                        HorizontalAlignment="Right"
                                        Padding="8,2"
                                        DockPanel.Dock="Right" />
                                <ComboBox ItemsSource="{Binding AvailableConditionTypes}"
                                          SelectedItem="{Binding SelectedNewConditionType}"
                                          HorizontalAlignment="Right"
                                          Width="160"
                                          Margin="0,0,6,0"
                                          DockPanel.Dock="Right">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource ConditionTypeNameConverter}}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </DockPanel>

                            <!-- Condition rows — templates resolved from Application.Resources by VM type -->
                            <ItemsControl ItemsSource="{Binding Conditions}"
                                          behaviors:ScrollNewItemsIntoView.Enabled="True" />

                        </StackPanel>
                    </DataTemplate>
                </ContentControl.Resources>
            </ContentControl>
        </ScrollViewer>
    </Grid>
</UserControl>
