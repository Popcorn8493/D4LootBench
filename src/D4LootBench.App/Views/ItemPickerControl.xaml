<UserControl
    x:Class="D4LootBench.App.Views.ItemPickerControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:cond="clr-namespace:D4LootBench.App.ViewModels.Conditions"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance Type=cond:PickerViewModel, IsDesignTimeCreatable=False}">

    <StackPanel>
        <!-- Search box -->
        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                 Margin="0,0,0,4"
                 ToolTip="Filter available items" />

        <!-- Two-panel picker -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Available items -->
            <StackPanel Grid.Column="0">
                <TextBlock Text="Available" FontSize="11"
                           Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                           Margin="0,0,0,2" />
                <ListBox x:Name="AvailableList"
                         ItemsSource="{Binding Available}"
                         SelectionMode="Extended"
                         DisplayMemberPath="DisplayName"
                         MinHeight="110"
                         MaxHeight="210"
                         ToolTip="Double-click, drag to Selected, or use → to add; Ctrl/Shift for multi-select"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         SelectionChanged="AvailableList_SelectionChanged"
                         MouseDoubleClick="AvailableList_MouseDoubleClick"
                         PreviewMouseLeftButtonDown="List_PreviewMouseLeftButtonDown"
                         PreviewMouseMove="List_PreviewMouseMove"
                         AllowDrop="True"
                         DragOver="AvailableList_DragOver"
                         Drop="AvailableList_Drop" />
            </StackPanel>

            <!-- Add / Remove buttons -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0">
                <Button Content="→"
                        IsEnabled="{Binding HasAvailableSelection}"
                        Click="AddButton_Click"
                        Width="32" Margin="0,0,0,6"
                        ToolTip="Add selected" />
                <Button Content="←"
                        IsEnabled="{Binding HasCurrentSelection}"
                        Click="RemoveButton_Click"
                        Width="32"
                        ToolTip="Remove selected" />
            </StackPanel>

            <!-- Selected items -->
            <StackPanel Grid.Column="2">
                <DockPanel Margin="0,0,0,2" LastChildFill="False">
                    <TextBlock FontSize="11"
                               Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                               VerticalAlignment="Center"
                               DockPanel.Dock="Left">
                        <Run Text="Selected" />
                        <Run Text="{Binding SelectionCountDisplay, Mode=OneWay}" />
                    </TextBlock>
                    <Button Content="Clear all"
                            Command="{Binding ClearAllCommand}"
                            FontSize="10"
                            Padding="6,1"
                            DockPanel.Dock="Right"
                            ToolTip="Remove every selected item" />
                </DockPanel>
                <ListBox x:Name="SelectedList"
                         ItemsSource="{Binding Selected}"
                         SelectionMode="Extended"
                         DisplayMemberPath="DisplayName"
                         MinHeight="110"
                         MaxHeight="210"
                         ToolTip="Double-click or use ← to remove; drag into another list to move; Ctrl/Shift for multi-select"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         SelectionChanged="SelectedList_SelectionChanged"
                         MouseDoubleClick="SelectedList_MouseDoubleClick"
                         PreviewMouseLeftButtonDown="List_PreviewMouseLeftButtonDown"
                         PreviewMouseMove="List_PreviewMouseMove"
                         AllowDrop="True"
                         DragOver="SelectedList_DragOver"
                         Drop="SelectedList_Drop"
                         PreviewMouseRightButtonDown="SelectedList_PreviewMouseRightButtonDown"
                         ContextMenuOpening="SelectedList_ContextMenuOpening">
                    <ListBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="{Binding EntryActionLabel}"
                                      Click="MoveEntryMenuItem_Click" />
                        </ContextMenu>
                    </ListBox.ContextMenu>
                </ListBox>
            </StackPanel>
        </Grid>
    </StackPanel>
</UserControl>
