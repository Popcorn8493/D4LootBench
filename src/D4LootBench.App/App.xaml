<Application
    x:Class="D4LootBench.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:D4LootBench.App.Converters"
    ThemeMode="Light">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Views/ConditionTemplates.xaml" />
                <ResourceDictionary Source="Themes/EditableCombo.xaml" />
                <!-- Swapped for Themes/Dark.xaml by ThemeService when dark mode is on
                     (exact-source match — see ThemeService before renaming these) -->
                <ResourceDictionary Source="Themes/Light.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <conv:ConditionTypeNameConverter x:Key="ConditionTypeNameConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
